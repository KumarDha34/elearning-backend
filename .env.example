# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=elearning
POSTGRES_USER=elearning
POSTGRES_PASSWORD=elearning
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache + Celery broker/result backend) ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# --- SMS gateways (Nepal) ---
SMS_PRIMARY_PROVIDER=sparrow          # sparrow | aakash | console
SMS_FALLBACK_PROVIDER=aakash          # sparrow | aakash | console | none

SPARROW_SMS_TOKEN=replace-with-real-token
SPARROW_SMS_FROM=elearning
SPARROW_SMS_BASE_URL=https://api.sparrowsms.com/v2/sms/

AAKASH_SMS_AUTH_TOKEN=replace-with-real-token
AAKASH_SMS_BASE_URL=https://sms.aakashsms.com/sms/v3/send/

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
